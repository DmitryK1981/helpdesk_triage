# Ключ от https://proxyapi.ru (OpenAI-совместимый прокси)
PROXYAPI_KEY=sk-proxyapi-xxxxxxxxxxxxxxxx
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# Модель и температура для LLM-триажа
LLM_MODEL=openai/gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=20

# Путь к файлу SQLite
DB_PATH=tickets.db

# Лимит запросов в минуту на один client_id
RATE_LIMIT_PER_MINUTE=5

LOG_LEVEL=INFO
